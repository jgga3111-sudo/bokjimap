# 복지클릭 환경변수 견본 — 이름만 적는다. 값은 .env.local(로컬)과
# Vercel 환경변수(배포)에만 넣고 절대 커밋하지 않는다.

# ── 공공데이터포털 (수집 스크립트용 — scripts/fetch-*.mjs) ─────────
# 포털이 주는 두 키 중 **인코딩된 것(Encoding)**을 넣는다.
DATA_GO_KR_SERVICE_KEY_ENCODED=

# ── 계정 기능 (2026-09-11) ──────────────────────────────────────
# 1이면 가입·로그인 화면, 헤더 링크, 개인정보처리방침의 회원 조항이 켜진다.
# 빌드 때 박히므로 바꾸면 다시 배포해야 한다. 키가 다 들어오고 방침
# 시행일을 정하기 전에는 비워 둔다.
NEXT_PUBLIC_AUTH_ON=

# Supabase 대시보드 → Project Settings → API Keys
# 브라우저에 안 실리도록 NEXT_PUBLIC_을 붙이지 않는다(서버에서만 쓴다).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# 탈퇴(계정 삭제)에만 쓰는 비밀 키. RLS를 건너뛰므로 다른 데 쓰지 않는다.
SUPABASE_SECRET_KEY=
